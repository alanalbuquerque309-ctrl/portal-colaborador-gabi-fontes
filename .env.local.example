# Copie para .env.local — mesmos valores do Vercel (Settings → Environment Variables)
# URL canónica do site (Open Graph / previews). Em produção na Vercel podes omitir (usa VERCEL_URL).
# NEXT_PUBLIC_SITE_URL=https://portal-colaborador-gabi-fontes.vercel.app

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role (apenas servidor) — necessário para finalizar onboarding
SUPABASE_SERVICE_ROLE_KEY=

# Bootstrap do banco (criar tabelas) — use no Vercel para api/admin/bootstrap-db
DATABASE_URL=          # Supabase: Settings → Database → Connection string (URI)
BOOTSTRAP_SECRET=      # Qualquer string secreta para proteger a rota

# Vídeo de boas-vindas — OPCIONAL. Deixe vazio na Vercel (usa Supabase Storage automaticamente).
# NÃO use /onboarding/boas-vindas.mp4 em produção (ficheiro não existe na Vercel).
# Upload: npm run upload:video-boas-vindas
# NEXT_PUBLIC_VIDEO_BOAS_VINDAS=

# Quinta do café — treino embedado (YouTube / Shorts)
# Colaboradores (portal → Grãos, +5 Grãos ao concluir). Padrão no código se vazio:
# NEXT_PUBLIC_QUINTA_YOUTUBE_URL=https://youtu.be/dd1bsHYYqjg
# NEXT_PUBLIC_QUINTA_TITULO=
# NEXT_PUBLIC_QUINTA_RESUMO=
# Apresentador (acima do vídeo — nome, cargo e por que ouvir):
# NEXT_PUBLIC_QUINTA_APRESENTADOR_NOME=
# NEXT_PUBLIC_QUINTA_APRESENTADOR_CARGO=
# NEXT_PUBLIC_QUINTA_APRESENTADOR_CREDENCIAL=
# Liderança (portal → Avaliação da equipe, sem Grãos):
# NEXT_PUBLIC_QUINTA_YOUTUBE_URL_LIDERES=https://youtube.com/shorts/0XYHQQ3RuTY
# NEXT_PUBLIC_QUINTA_TITULO_LIDERES=
# NEXT_PUBLIC_QUINTA_RESUMO_LIDERES=
# NEXT_PUBLIC_QUINTA_APRESENTADOR_NOME_LIDERES=
# NEXT_PUBLIC_QUINTA_APRESENTADOR_CARGO_LIDERES=
# NEXT_PUBLIC_QUINTA_APRESENTADOR_CREDENCIAL_LIDERES=
# Formato opcional: shorts | horizontal (Shorts detectado automaticamente na URL)
# NEXT_PUBLIC_QUINTA_FORMATO_LIDERES=shorts

# Acesso admin (somente em variáveis de ambiente — não commitar senhas)
# ADMIN_PASSWORD=senha_antiga_unica (opcional)
# ADMIN_ALAN_LOGIN=alan
# ADMIN_ALAN_PASSWORD=obrigatório para a rota /api/login/alan-entrar (bootstrap técnico; login normal = CPF + senha em colaboradores)

# Botão de ajuda rápida (Bloco 10)
NEXT_PUBLIC_WHATSAPP_AJUDA=5521999999999   # Número com DDI, sem + ou espaços
NEXT_PUBLIC_EMAIL_AJUDA=rh@gabifontes.com.br

# Canal de ajuda (chat interno — UUID do colaborador que responde, ex. Daniel)
# Copiar de Supabase → colaboradores.id
NEXT_PUBLIC_AJUDA_RESPONSAVEL_COLABORADOR_ID=
# Opcional: nome exibido no botão flutuante (default: Daniel)
NEXT_PUBLIC_AJUDA_RESPONSAVEL_NOME=Daniel
